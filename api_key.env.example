# Copy this file to api_key.env. Never commit the actual file.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=replace-with-your-available-model
LLM_API_KEY=replace-with-your-key
LLM_JSON_MODE=true
LLM_CONTEXT_TOKENS=32000
# Local Ollama example: LLM_BASE_URL=http://localhost:11434/v1
# Set a locally available model and leave LLM_API_KEY empty if not required.

# DeepSeek-specific optional settings; omit for providers without these extensions.
# LLM_THINKING=true
# LLM_REASONING_EFFORT=low
