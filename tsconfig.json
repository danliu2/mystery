{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "jsx": "react-jsx", "types": ["node"], "noEmit": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts"]
}
